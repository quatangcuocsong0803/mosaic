                            );\
\
                          return `$\{point.x\},$\{point.y\}`;\
                        \})\
                        .join(" ")\}\
                      className=\{styles.chartGrid\}\
                    />\
                  ),\
                )\}\
\
                \{enneagramTypeOrder.map(\
