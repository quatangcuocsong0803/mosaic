\
                \{[0.25, 0.5, 0.75, 1].map(\
                  (level) => (\
                    <polygon\
                      key=\{level\}\
                      points=\{enneagramTypeOrder\
                        .map((_, index) => \{\
                          const point =\
                            polarPoint(\
                              index,\
                              25 +\
